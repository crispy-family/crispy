@model Crispy.Core.Entities.Recipe
@{
    ViewData["Title"] = Model.Title;
    var comments = ViewBag.Comments as IEnumerable<Crispy.Core.Entities.Comment>;
    var currentUserId = User.Identity?.Name;
    int? modelUserId = Model.UserId;
    int? currentUserIdInt = null;
    if (int.TryParse(currentUserId, out var parsedId))
    {
        currentUserIdInt = parsedId;
    }
}

<div class="container mt-5 mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm text-center" role="alert">
            <strong>Супер!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card shadow-sm border-0 mb-5">
        
        <!-- Додаємо секцію відображення фотографії -->
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="Фото рецепту @Model.Title" style="max-height: 500px; object-fit: cover;">
        }
        
        <div class="card-body p-5">
            <h1 class="fw-bold mb-4">@Model.Title</h1>
            
            <!-- Блок автора та підписки -->
            <div class="d-flex align-items-center mb-4 bg-light p-3 rounded">
                <div class="me-3">
                    <strong>Автор:</strong> 
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" class="text-decoration-none fs-5">
                        @(Model.User?.UserName ?? "Невідомий Шеф")
                    </a>
                </div>

                @if (User.Identity!.IsAuthenticated && currentUserIdInt != Model.UserId)
                {
                    <form asp-controller="Profile" asp-action="ToggleFollow" method="post" class="m-0">
                        <!-- Зверніть увагу: ми повертаємось на ту саму сторінку рецепту після підписки -->
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <input type="hidden" name="followedUserId" value="@Model.UserId" />
                        
                        @if (ViewBag.IsFollowing == true)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                Відписатися
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                                Підписатися
                            </button>
                        }
                    </form>
                }
            </div>
            
            <p class="fs-5" style="white-space: pre-wrap;">@Model.Description</p>
        </div>
        <hr class="my-4" />
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Сподобався рецепт?</h4>

            @if (User.Identity!.IsAuthenticated)
            {
                <form asp-controller="Recipe" asp-action="AddToShoppingList" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                        🛒 Додати продукти в список покупок
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success">
                    Увійдіть, щоб додати в список покупок
                </a>
            }
        </div>
    </div>

    <!-- Решта коду сторінки (коментарі) залишається без змін -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h3 class="mb-4">💬 Коментарі (@comments?.Count())</h3>

            @if (User.Identity!.IsAuthenticated)
            {
                <div class="card bg-light border-0 mb-4 shadow-sm">
                    <div class="card-body">
                        <form asp-controller="Recipe" asp-action="AddComment" method="post">
                            <input type="hidden" name="recipeId" value="@Model.Id" />
                            <div class="mb-3">
                                <textarea name="text" class="form-control" rows="3" placeholder="Напишіть свої враження від рецепту..." required></textarea>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-warning fw-bold">Надіслати коментар</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-secondary text-center">
                    Щоб залишити коментар, будь ласка, <a asp-controller="Account" asp-action="Login">увійдіть</a> або <a asp-controller="Account" asp-action="Register">зареєструйтеся</a>.
                </div>
            }

            @if (comments != null && comments.Any())
            {
                foreach (var comment in comments)
                {
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <strong class="text-primary">@(comment.User?.UserName ?? "Користувач")</strong>
                                <small class="text-muted">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <p class="mb-0">@comment.Text</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted text-center mt-4">Поки що немає коментарів. Станьте першим!</p>
            }
        </div>
    </div>

    @* У місці, де у вас є кнопка видалення: *@
    @if (User.Identity!.IsAuthenticated && (Model.UserId == currentUserIdInt || User.IsInRole("Admin")))
    {
        <form asp-controller="Recipe" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Ви впевнені, що хочете видалити цей рецепт?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger shadow-sm">
                🗑️ Видалити
            </button>
        </form>
    }
</div>