@model Crispy.Web.Models.CreateRecipeViewModel
@{
    ViewData["Title"] = "Додати рецепт";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <h2>Створити новий рецепт</h2>
        <!-- Обов'язково додаємо enctype -->
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title">Назва страви</label>
                <input asp-for="Title" class="form-control" placeholder="Наприклад: Борщ український" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Додайте цей блок у форму створення рецепту між полями Назва та Опис -->
            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="form-label">Категорія</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">Оберіть категорію...</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description">Опис та кроки приготування</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ImageFile" class="form-label">Фото готової страви</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Зберегти рецепт</button>
        </form>
    </div>
</div>