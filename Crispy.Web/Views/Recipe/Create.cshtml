@model Crispy.Web.Models.CreateRecipeViewModel
@{
    ViewData["Title"] = "Додати рецепт";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <h2>Створити новий рецепт</h2>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title">Назва страви</label>
                <input asp-for="Title" class="form-control" placeholder="Наприклад: Борщ український" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="form-label">Категорія</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">Оберіть категорію...</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description">Опис та кроки приготування</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-4 p-3 border rounded bg-light">
                <h5 class="fw-bold mb-3">🛒 Інгредієнти</h5>

                <div id="ingredients-container"></div>

                <button type="button" class="btn btn-sm btn-outline-success mt-2 fw-bold" onclick="addIngredient()">
                    + Додати інгредієнт
                </button>
            </div>
            <div class="form-group mb-4">
                <label asp-for="ImageFile" class="form-label">Фото готової страви</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Зберегти рецепт</button>
        </form>
    </div>
</div>

<script>
    let ingredientIndex = 0;

    function addIngredient() {
        const container = document.getElementById('ingredients-container');
        const row = document.createElement('div');
        row.className = 'row mb-2 align-items-center ingredient-row';

        // Використовуємо Ingredients з великої літери, щоб точно співпадало з ViewModel
        row.innerHTML = `
            <div class="col-md-5">
                <input type="text" name="Ingredients[${ingredientIndex}].Name" class="form-control form-control-sm" placeholder="Назва (напр. Борошно)" required />
            </div>
            <div class="col-md-3">
                <input type="number" step="0.1" name="Ingredients[${ingredientIndex}].Quantity" class="form-control form-control-sm" placeholder="Кількість (напр. 500)" required />
            </div>
            <div class="col-md-3">
                <input type="text" name="Ingredients[${ingredientIndex}].Unit" class="form-control form-control-sm" placeholder="Одиниці (напр. грам)" required />
            </div>
            <div class="col-md-1 text-end">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="this.closest('.ingredient-row').remove()">
                    ❌
                </button>
            </div>
        `;

        container.appendChild(row);
        ingredientIndex++;
    }

    // Автоматично додаємо один порожній рядок при завантаженні сторінки
    window.onload = function() {
        addIngredient();
    };
</script>