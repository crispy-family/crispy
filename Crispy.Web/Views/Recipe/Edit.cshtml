@model Crispy.Core.Entities.Recipe
@{
    ViewData["Title"] = "Редагувати рецепт";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <h2 class="fw-bold mb-4">✏️ Редагувати: @Model.Title</h2>

                    <form asp-controller="Recipe" asp-action="Edit" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Назва страви</label>
                            <input type="text" name="title" class="form-control" value="@Model.Title" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Опис та кроки приготування</label>
                            <textarea name="description" class="form-control" rows="6" required>@Model.Description</textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-warning fw-bold px-4">Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>