@model IEnumerable<Crispy.Core.Entities.User>

@{
    ViewData["Title"] = "Панель Адміністратора";
}

<div class="container mt-5">
    <h2 class="mb-4 text-warning">Панель Адміністратора - Користувачі</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive bg-light p-4 rounded shadow-sm border">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Ім'я користувача</th>
                    <th>Email</th>
                    <th>Дата реєстрації</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@user.RegistrationDate.ToShortDateString()</td>
                        <td class="text-center">
                            @if (user.UserName != User.Identity?.Name)
                            {
                                <form asp-action="DeleteUser" asp-controller="Admin" method="post" class="d-inline" onsubmit="return confirm('Ви впевнені, що хочете видалити цього користувача? Всі його рецепти і коментарі також можуть бути видалені.');">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        🗑️ Видалити
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-success">Це ви</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>